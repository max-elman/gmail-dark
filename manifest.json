{
  "manifest_version": 3,
  "name": "Gmail Dark",
  "description": "Dark mode for Gmail: follows your Mac's setting, a schedule, or sunset. Nothing leaves your browser.",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "storage",
    "geolocation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "css": [
        "dark.css"
      ],
      "js": [
        "theme.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gmail Dark",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-dark": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Switch Gmail between dark and light"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
